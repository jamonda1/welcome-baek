{
    "manifest_version": 3,
    "name": "Welcome Baek",
    "version": "0.1.0",
    "description": "Better coding experience for Baekjoon",
    "permissions": ["storage"],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["https://www.acmicpc.net/problem/*", "https://acmicpc.net/problem/*"],
            "js": ["problem.js"],
            "css": ["layout.css"],
            "run_at": "document_idle"
        }
    ]
}
