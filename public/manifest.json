{
    "manifest_version": 3,
    "name": "Welcome Baek",
    "version": "0.3.0",
    "minimum_chrome_version": "111",
    "description": "Better coding experience for Baekjoon",
    "permissions": ["storage"],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["https://www.acmicpc.net/problem/*", "https://acmicpc.net/problem/*"],
            "js": ["problem.js"],
            "css": ["layout.css"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.acmicpc.net/submit/*", "https://acmicpc.net/submit/*"],
            "js": ["submit-bridge.js"],
            "run_at": "document_idle",
            "world": "MAIN"
        },
        {
            "matches": ["https://www.acmicpc.net/submit/*", "https://acmicpc.net/submit/*"],
            "js": ["submit.js"],
            "css": ["submit.css"],
            "run_at": "document_idle",
            "world": "ISOLATED"
        }
    ]
}
