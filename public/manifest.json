{
    "manifest_version": 3,
    "name": "Welcome Baek",
    "version": "0.4.0",
    "minimum_chrome_version": "111",
    "description": "Better coding experience for Baekjoon",
    "permissions": ["storage"],
    "action": {
        "default_popup": "popup.html"
    },
    "sandbox": {
        "pages": ["java-sandbox.html"]
    },
    "content_security_policy": {
        "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src blob:; connect-src 'none'"
    },
    "web_accessible_resources": [
        {
            "resources": ["java-sandbox.html", "java/*.wasm", "java/jdk-11.zip"],
            "matches": ["https://www.acmicpc.net/*", "https://acmicpc.net/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["https://www.acmicpc.net/problem/*", "https://acmicpc.net/problem/*"],
            "js": ["problem.js"],
            "css": ["layout.css"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.acmicpc.net/submit/*", "https://acmicpc.net/submit/*"],
            "js": ["submit-bridge.js"],
            "run_at": "document_idle",
            "world": "MAIN"
        },
        {
            "matches": ["https://www.acmicpc.net/submit/*", "https://acmicpc.net/submit/*"],
            "js": ["submit.js"],
            "css": ["submit.css"],
            "run_at": "document_idle",
            "world": "ISOLATED"
        }
    ]
}
