{
    "manifest_version": 3,
    "name": "Welcome Baek",
    "version": "1.1.0",
    "minimum_chrome_version": "111",
    "description": "Better coding experience for Baekjoon",
    "permissions": ["storage"],
    "icons": {
        "16": "icons/welcome-baek-16.png",
        "32": "icons/welcome-baek-32.png",
        "48": "icons/welcome-baek-48.png",
        "128": "icons/welcome-baek-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/welcome-baek-16.png",
            "32": "icons/welcome-baek-32.png"
        }
    },
    "sandbox": {
        "pages": ["java-sandbox.html", "python-sandbox.html"]
    },
    "content_security_policy": {
        "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src blob:; connect-src 'none'"
    },
    "web_accessible_resources": [
        {
            "resources": ["java-sandbox.html", "java/*.wasm", "java/jdk-11.zip"],
            "matches": ["https://www.acmicpc.net/*", "https://acmicpc.net/*"]
        },
        {
            "resources": ["python-sandbox.html", "python/pyodide.asm.wasm", "python/python_stdlib.zip", "python/pyodide-lock.json"],
            "matches": ["https://www.acmicpc.net/*", "https://acmicpc.net/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["https://www.acmicpc.net/problem/*", "https://acmicpc.net/problem/*"],
            "js": ["problem.js"],
            "css": ["layout.css"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.acmicpc.net/submit/*", "https://acmicpc.net/submit/*"],
            "js": ["submit-bridge.js"],
            "run_at": "document_idle",
            "world": "MAIN"
        },
        {
            "matches": ["https://www.acmicpc.net/submit/*", "https://acmicpc.net/submit/*"],
            "js": ["submit.js"],
            "css": ["submit.css"],
            "run_at": "document_idle",
            "world": "ISOLATED"
        }
    ]
}
